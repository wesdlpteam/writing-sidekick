OPENAI_API_KEY=
# Feedback model (step 2). Leave blank for the default, gpt-5.4. Use gpt-5.4-mini to cut cost.
OPENAI_MODEL=
# Independent teaching/editing review. Defaults to gpt-5.4 even if generation uses mini.
# A custom review model must support Chat Completions JSON and medium reasoning_effort.
OPENAI_REVIEW_MODEL=
# Reads the handwriting (step 1). Leave blank for the default, gpt-5.4. Best accuracy on apostrophes and tricky handwriting.
OPENAI_TRANSCRIBE_MODEL=
# Read-aloud voice for the Listen buttons. Leave blank for the defaults: gpt-4o-mini-tts with the "marin" voice.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
